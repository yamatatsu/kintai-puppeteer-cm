{
	"name": "kintai",
	"version": "1.0.0",
	"main": "index.js",
	"license": "MIT",
	"scripts": {
		"syukkin": "env DRY_RUN=true bun src/syukkin.ts",
		"taikin": "env DRY_RUN=true bun src/taikin.ts",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write . && bun run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "1.4.2",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"p-retry": "^7.1.1",
		"puppeteer": "^24.42.0"
	},
	"overrides": {
		"basic-ftp": "^6.0.0"
	}
}
